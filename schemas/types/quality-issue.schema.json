{
  "$defs": {
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_type": {
          "enum": [
            "atomic_claim",
            "knowledge_atom",
            "core_idea",
            "mental_model",
            "meta_principle"
          ],
          "title": "Object Type",
          "type": "string"
        },
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "book_id": {
          "format": "uuid",
          "title": "Book Id",
          "type": "string"
        },
        "edition_id": {
          "format": "uuid",
          "title": "Edition Id",
          "type": "string"
        },
        "chapter_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chapter Id"
        },
        "chapter_generation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chapter Generation Id"
        },
        "book_generation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Book Generation Id"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "book_id",
        "edition_id"
      ],
      "title": "ObjectRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "issue_type": {
      "enum": [
        "UNSUPPORTED_CLAIM",
        "CONTRADICTED_CLAIM",
        "OVERCLAIM",
        "WEAK_EVIDENCE",
        "BROKEN_CITATION",
        "MAJOR_OMISSION",
        "DUPLICATE_KNOWLEDGE",
        "CONCEPT_DISTORTION",
        "SYNTHESIS_OVERREACH",
        "LOW_TRACEABILITY",
        "LOW_CHAPTER_COVERAGE"
      ],
      "title": "Issue Type",
      "type": "string"
    },
    "severity": {
      "enum": [
        "critical",
        "major",
        "minor",
        "warning"
      ],
      "title": "Severity",
      "type": "string"
    },
    "object_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 24,
      "title": "Object Refs",
      "type": "array"
    },
    "source_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 24,
      "title": "Source Refs",
      "type": "array"
    },
    "chapter_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chapter Id"
    },
    "summary": {
      "maxLength": 1200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Summary",
      "type": "string"
    },
    "suggested_action": {
      "enum": [
        "rerun_claim_extraction",
        "rerun_chapter_atoms",
        "rerun_book_synthesis",
        "inspect_source",
        "accept_as_low_confidence"
      ],
      "title": "Suggested Action",
      "type": "string"
    },
    "reviewer_confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Reviewer Confidence",
      "type": "number"
    },
    "issue_id": {
      "title": "Issue Id",
      "type": "string"
    },
    "auto_recheck_attempted": {
      "default": false,
      "title": "Auto Recheck Attempted",
      "type": "boolean"
    },
    "status": {
      "default": "open",
      "enum": [
        "open",
        "resolved"
      ],
      "title": "Status",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    }
  },
  "required": [
    "issue_type",
    "severity",
    "summary",
    "suggested_action",
    "reviewer_confidence",
    "issue_id"
  ],
  "title": "ReviewIssue",
  "type": "object"
}
