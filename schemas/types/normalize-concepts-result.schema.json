{
  "$defs": {
    "CanonicalConcept": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "concept_id": {
          "pattern": "^concept_[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Concept Id",
          "type": "string"
        },
        "canonical_name": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Canonical Name",
          "type": "string"
        },
        "zh_name": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zh Name"
        },
        "aliases": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 24,
          "title": "Aliases",
          "type": "array"
        },
        "source_terms": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Source Terms",
          "type": "array"
        },
        "atom_ids": {
          "items": {
            "type": "string"
          },
          "title": "Atom Ids",
          "type": "array"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/ConceptRelation"
          },
          "maxItems": 12,
          "title": "Relations",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "human_verified": {
          "const": false,
          "default": false,
          "title": "Human Verified",
          "type": "boolean"
        },
        "locked": {
          "const": false,
          "default": false,
          "title": "Locked",
          "type": "boolean"
        }
      },
      "required": [
        "concept_id",
        "canonical_name",
        "source_terms",
        "confidence"
      ],
      "title": "CanonicalConcept",
      "type": "object"
    },
    "ConceptRelation": {
      "additionalProperties": false,
      "properties": {
        "target_concept_id": {
          "pattern": "^concept_[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Target Concept Id",
          "type": "string"
        },
        "relation": {
          "enum": [
            "same_as",
            "related_to"
          ],
          "title": "Relation",
          "type": "string"
        },
        "reason": {
          "maxLength": 1200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "target_concept_id",
        "relation",
        "reason"
      ],
      "title": "ConceptRelation",
      "type": "object"
    },
    "EngineMetadata": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "codex",
          "default": "codex",
          "title": "Engine",
          "type": "string"
        }
      },
      "title": "EngineMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "book_id": {
      "format": "uuid",
      "title": "Book Id",
      "type": "string"
    },
    "edition_id": {
      "format": "uuid",
      "title": "Edition Id",
      "type": "string"
    },
    "generation_id": {
      "format": "uuid",
      "title": "Generation Id",
      "type": "string"
    },
    "context_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Hash",
      "type": "string"
    },
    "dependency_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dependency Hash",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "normalized_schema_version": {
      "title": "Normalized Schema Version",
      "type": "string"
    },
    "normalized_document_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Normalized Document Hash",
      "type": "string"
    },
    "classification_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Classification Hash",
      "type": "string"
    },
    "workflow_version": {
      "title": "Workflow Version",
      "type": "string"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "context_package_version": {
      "const": "1.2",
      "default": "1.2",
      "title": "Context Package Version",
      "type": "string"
    },
    "source_parse_quality": {
      "enum": [
        "pass",
        "review_recommended"
      ],
      "title": "Source Parse Quality",
      "type": "string"
    },
    "generated_by": {
      "$ref": "#/$defs/EngineMetadata"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "concepts": {
      "items": {
        "$ref": "#/$defs/CanonicalConcept"
      },
      "maxItems": 256,
      "title": "Concepts",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "book_id",
    "edition_id",
    "generation_id",
    "context_hash",
    "dependency_hash",
    "input_hash",
    "source_sha256",
    "normalized_schema_version",
    "normalized_document_hash",
    "classification_hash",
    "workflow_version",
    "prompt_version",
    "source_parse_quality",
    "generated_by",
    "concepts"
  ],
  "title": "ConceptsResult",
  "type": "object"
}
