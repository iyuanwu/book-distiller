{
  "$defs": {
    "EngineMetadata": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "codex",
          "default": "codex",
          "title": "Engine",
          "type": "string"
        }
      },
      "title": "EngineMetadata",
      "type": "object"
    },
    "MentalModel": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "model_id": {
          "pattern": "^model_\\d{3,}$",
          "title": "Model Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "zh_name": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zh Name"
        },
        "description": {
          "maxLength": 1200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "core_idea_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Core Idea Ids",
          "type": "array"
        },
        "atom_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Atom Ids",
          "type": "array"
        },
        "concept_ids": {
          "items": {
            "pattern": "^concept_[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 24,
          "title": "Concept Ids",
          "type": "array"
        },
        "mechanism": {
          "maxLength": 1200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Mechanism",
          "type": "string"
        },
        "when_to_use": {
          "items": {
            "maxLength": 1200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 8,
          "title": "When To Use",
          "type": "array"
        },
        "limitations": {
          "items": {
            "maxLength": 1200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Limitations",
          "type": "array"
        },
        "promotion_reason": {
          "maxLength": 1200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Promotion Reason",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "source_type": {
          "const": "source",
          "default": "source",
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "name",
        "description",
        "mechanism",
        "promotion_reason",
        "confidence"
      ],
      "title": "MentalModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "book_id": {
      "format": "uuid",
      "title": "Book Id",
      "type": "string"
    },
    "edition_id": {
      "format": "uuid",
      "title": "Edition Id",
      "type": "string"
    },
    "generation_id": {
      "format": "uuid",
      "title": "Generation Id",
      "type": "string"
    },
    "context_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Hash",
      "type": "string"
    },
    "dependency_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dependency Hash",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "normalized_schema_version": {
      "title": "Normalized Schema Version",
      "type": "string"
    },
    "normalized_document_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Normalized Document Hash",
      "type": "string"
    },
    "classification_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Classification Hash",
      "type": "string"
    },
    "workflow_version": {
      "title": "Workflow Version",
      "type": "string"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "context_package_version": {
      "const": "1.2",
      "default": "1.2",
      "title": "Context Package Version",
      "type": "string"
    },
    "source_parse_quality": {
      "enum": [
        "pass",
        "review_recommended"
      ],
      "title": "Source Parse Quality",
      "type": "string"
    },
    "generated_by": {
      "$ref": "#/$defs/EngineMetadata"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "mental_models": {
      "items": {
        "$ref": "#/$defs/MentalModel"
      },
      "maxItems": 32,
      "title": "Mental Models",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "book_id",
    "edition_id",
    "generation_id",
    "context_hash",
    "dependency_hash",
    "input_hash",
    "source_sha256",
    "normalized_schema_version",
    "normalized_document_hash",
    "classification_hash",
    "workflow_version",
    "prompt_version",
    "source_parse_quality",
    "generated_by",
    "mental_models"
  ],
  "title": "ModelsResult",
  "type": "object"
}
