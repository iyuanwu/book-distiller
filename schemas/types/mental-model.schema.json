{
  "$defs": {
    "AtomReference": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "title": "Chapter Id",
          "type": "string"
        },
        "chapter_generation_id": {
          "format": "uuid",
          "title": "Chapter Generation Id",
          "type": "string"
        },
        "atom_id": {
          "title": "Atom Id",
          "type": "string"
        }
      },
      "required": [
        "chapter_id",
        "chapter_generation_id",
        "atom_id"
      ],
      "title": "AtomReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "model_id": {
      "pattern": "^model_\\d{3,}$",
      "title": "Model Id",
      "type": "string"
    },
    "name": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Name",
      "type": "string"
    },
    "zh_name": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Zh Name"
    },
    "description": {
      "maxLength": 1200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Description",
      "type": "string"
    },
    "core_idea_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Core Idea Ids",
      "type": "array"
    },
    "atom_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "title": "Atom Ids",
      "type": "array"
    },
    "concept_ids": {
      "items": {
        "pattern": "^concept_[a-z0-9]+(?:[_-][a-z0-9]+)*$",
        "type": "string"
      },
      "maxItems": 24,
      "title": "Concept Ids",
      "type": "array"
    },
    "mechanism": {
      "maxLength": 1200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Mechanism",
      "type": "string"
    },
    "when_to_use": {
      "items": {
        "maxLength": 1200,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 8,
      "title": "When To Use",
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 1200,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Limitations",
      "type": "array"
    },
    "promotion_reason": {
      "maxLength": 1200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Promotion Reason",
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "source_type": {
      "const": "source",
      "default": "source",
      "title": "Source Type",
      "type": "string"
    },
    "atom_refs": {
      "items": {
        "$ref": "#/$defs/AtomReference"
      },
      "title": "Atom Refs",
      "type": "array"
    }
  },
  "required": [
    "model_id",
    "name",
    "description",
    "mechanism",
    "promotion_reason",
    "confidence",
    "atom_refs"
  ],
  "title": "PublishedMentalModel",
  "type": "object"
}
