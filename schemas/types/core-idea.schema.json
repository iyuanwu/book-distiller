{
  "$defs": {
    "AtomReference": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "title": "Chapter Id",
          "type": "string"
        },
        "chapter_generation_id": {
          "format": "uuid",
          "title": "Chapter Generation Id",
          "type": "string"
        },
        "atom_id": {
          "title": "Atom Id",
          "type": "string"
        }
      },
      "required": [
        "chapter_id",
        "chapter_generation_id",
        "atom_id"
      ],
      "title": "AtomReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "core_idea_id": {
      "pattern": "^idea_\\d{3,}$",
      "title": "Core Idea Id",
      "type": "string"
    },
    "title": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Title",
      "type": "string"
    },
    "statement": {
      "maxLength": 1200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Statement",
      "type": "string"
    },
    "atom_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Atom Ids",
      "type": "array"
    },
    "concept_ids": {
      "items": {
        "pattern": "^concept_[a-z0-9]+(?:[_-][a-z0-9]+)*$",
        "type": "string"
      },
      "maxItems": 24,
      "title": "Concept Ids",
      "type": "array"
    },
    "supporting_chapters": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Chapters",
      "type": "array"
    },
    "importance": {
      "maximum": 1,
      "minimum": 0,
      "title": "Importance",
      "type": "number"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "promotion_reason": {
      "maxLength": 1200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Promotion Reason",
      "type": "string"
    },
    "source_type": {
      "const": "source",
      "default": "source",
      "title": "Source Type",
      "type": "string"
    },
    "atom_refs": {
      "items": {
        "$ref": "#/$defs/AtomReference"
      },
      "title": "Atom Refs",
      "type": "array"
    }
  },
  "required": [
    "core_idea_id",
    "title",
    "statement",
    "atom_ids",
    "importance",
    "confidence",
    "promotion_reason",
    "atom_refs"
  ],
  "title": "PublishedCoreIdea",
  "type": "object"
}
